[Unit]
Description=Daily NAS ship of Modbus sniffer chunks (02:05 local)

[Timer]
OnCalendar=*-*-* 02:05:00
# Pick a time that suits the NAS (for example while it is awake for other jobs).
# A missed run is not caught up at boot; the cache keeps the days for the next run.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
